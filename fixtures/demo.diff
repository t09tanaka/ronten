new file mode 100644
index 0000000..1a2b3c4
--- /dev/null
+++ b/src/middleware/auth.ts
@@ -0,0 +1,48 @@
+import type { NextFunction, Request, Response } from "express";
+import { verifyToken } from "../util/token";
+import { logRequest } from "../util/log";
+
+export interface AuthenticatedRequest extends Request {
+  userId?: string;
+}
+
+const PUBLIC_PATHS = new Set(["/health", "/login", "/signup"]);
+
+export function requireAuth(
+  req: AuthenticatedRequest,
+  res: Response,
+  next: NextFunction,
+): void {
+  if (PUBLIC_PATHS.has(req.path)) {
+    next();
+    return;
+  }
+
+  const header = req.headers.authorization;
+  if (!header || !header.startsWith("Bearer ")) {
+    logRequest(req.path, "missing bearer token");
+    res.status(401).json({ error: "unauthorized" });
+    return;
+  }
+
+  const token = header.slice("Bearer ".length);
+  try {
+    const payload = verifyToken(token);
+    req.userId = payload.sub;
+    next();
+  } catch (err) {
+    logRequest(req.path, `invalid token: ${String(err)}`);
+    res.status(401).json({ error: "unauthorized" });
+  }
+}
+
+export function requireRole(role: string) {
+  return (req: AuthenticatedRequest, res: Response, next: NextFunction): void => {
+    if (!req.userId) {
+      res.status(401).json({ error: "unauthorized" });
+      return;
+    }
+    // TODO: look up the user's roles once the roles table exists.
+    next();
+  };
+}
